#!/usr/bin/env bash
# MCP server (stdio) that lets an agent open SDD artifacts in the Spec Review reader.
# Keeps the caller's cwd: list_open_changes defaults to the agent's repository.
set -uo pipefail

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
plugin_dir=$(dirname -- "$script_dir")

PYTHONPATH="$plugin_dir${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m specreview.mcp_server
